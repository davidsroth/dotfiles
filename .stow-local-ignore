# Stow ignore file
# Files and patterns listed here will be ignored by GNU Stow

# Documentation files
^CLAUDE\.md$
README.md
README.*

# Version control
\.git
\.gitignore
\.gitmodules

# macOS system files
\.DS_Store

# Editor temporary files
.*\.swp
.*\.swo
.*~

# Stow metadata
\.stow-local-ignore
\.stowrc

# Other common files to ignore
LICENSE
LICENSE.*
CONTRIBUTING.*

# Installation and setup scripts
install.sh
macos-defaults.sh
justfile
Justfile

# Package management
Brewfile
Brewfile.lock.json

# Repo-level automation and reports (do not stow into $HOME)
^\.codex$

# Core runtime/auth state ignored by Git must never be linked into $HOME.
# .stowrc disables tree folding so these nested rules cannot be bypassed by a
# parent-directory symlink, while tracked neighboring configs remain stowable.
^/\.claude$
^/\.codex$
^/\.config/(gcloud|gws|herdr|sunsama|op|raycast|aetna-claims|tuxedo)$
^/\.config/gh/(config|hosts)\.yml$
^/\.config/gh-dash/(config|config\.local)\.yml$
^/\.config/espanso/(config|match)/local\.yml$
^/\.config/espanso/\.local_(email|address)$
^/\.config/nvim/\.luarc\.json$
^/\.config/k9s/config\.yaml$
^/\.config/opencode/(node_modules|bun\.lock|package-lock\.json)$
^/\.config/karabiner/automatic_backups$
^/\.config/tmux/plugins$
^/\.config/systemd/user/default\.target\.wants$
^/\.hammerspoon/(bin|Spoons)$

# Logs and transient files that should never be stowed
^.nvimlog$
^/.*__pycache__$
.*\.py[co]$

# Repo-level files that should not be stowed into $HOME
.*\.bundle$

# Example files
.*\.example$
.*\.example\..*$

# Local, host-specific configs that should never be stowed.
# Covers the canonical path plus any nested ".claude/.claude/" subtree that
# can accumulate when Claude Code runs inside a stowed .claude dir.
^/\.claude/settings\.local\.json$
^/\.claude/\.claude$
^/\.config/gh-dash/config\.local\.yml$
^/\.config/gh-dash/config\.local\.example\.yml$
# Hammerspoon's gitignored init.local.lua is intentionally stowed so the
# active ~/.hammerspoon config can load the machine-local key overrides.
