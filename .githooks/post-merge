#!/bin/sh
# Tracked hook (installed through an absolute core.hooksPath).
# 1. Keep git-lfs working (core.hooksPath replaces .git/hooks).
command -v git-lfs >/dev/null 2>&1 && git lfs post-merge "$@"
# 2. Refresh global Pi settings only when this is the canonical checkout.
hook_dir=$(unset CDPATH; cd "$(dirname "$0")" && pwd -P)
"$hook_dir/refresh-pi-settings" || true
